{
  "name": "eval-hiring-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seeds": "tsx --env-file-if-exists=.env.local scripts/probe-seeds.ts && tsx --env-file-if-exists=.env.local scripts/probe-seeds.ts --extra && tsx --env-file-if-exists=.env.local scripts/build-sources.ts",
    "fetch": "tsx --env-file-if-exists=.env.local scripts/fetch.ts",
    "extract": "tsx --env-file-if-exists=.env.local scripts/extract.ts",
    "news": "tsx --env-file-if-exists=.env.local scripts/news.ts",
    "sizes": "tsx --env-file-if-exists=.env.local scripts/sizes.ts",
    "score": "tsx --env-file-if-exists=.env.local scripts/score.ts",
    "themes": "tsx --env-file-if-exists=.env.local scripts/themes.ts",
    "briefs": "tsx --env-file-if-exists=.env.local scripts/briefs.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "all": "npm run fetch && npm run extract && npm run news && npm run sizes && npm run score && npm run themes && npm run score && npm run briefs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}